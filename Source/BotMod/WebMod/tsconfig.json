{
  "compilerOptions": {
    "target": "ES2017",
    "module": "es2020",
    // strict: the WebMod is fully typed (no any) and the oxlint type-aware
    // rules (strict-boolean-expressions, no-floating-promises) refuse to run
    // without strictNullChecks.
    "strict": true,
    // Defect-class check-only flags the tree already passes (2026-08-24).
    // noFallthroughCasesInSwitch is the goto-fail guard; the other two keep
    // control flow and subclassing explicit. Check-only: emit (and the
    // bundle.js freshness gate) is unaffected. noUnusedLocals/noUnusedParameters
    // stay off on purpose: every render row helper takes the same state bundle
    // (`busy` included) even where a helper ignores part of it, so per-param
    // pruning would fight that signature convention.
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": ".",
    "rootDir": ".",
    "sourceMap": false,
    // Comments stay out of the shipped artifact: the stock webserver serves
    // bundle.js uncompressed (see scripts/lint-webui.sh wire budget), so
    // every source comment is wire cost on each dashboard load. Read
    // bundle.ts for the annotated source.
    "removeComments": true
  },
  "files": ["bundle.ts"]
}
